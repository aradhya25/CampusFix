PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/campusfix
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
CLIENT_ORIGIN=http://localhost:5173

# Optional image uploads (configure these in server/.env, never in Vite variables)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resolution targets in hours. Defaults: urgent 4, high 24, medium 72, low 120.
SLA_TARGET_URGENT_HOURS=4
SLA_TARGET_HIGH_HOURS=24
SLA_TARGET_MEDIUM_HOURS=72
SLA_TARGET_LOW_HOURS=120

# Used only for the one-time staff bootstrap command:
STAFF_NAME=Campus Staff
STAFF_EMAIL=staff@example.com
STAFF_PASSWORD=replace-with-a-12-character-or-longer-password
